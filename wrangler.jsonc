{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "housesim",
  "main": "worker.ts",
  "compatibility_date": "2026-03-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
